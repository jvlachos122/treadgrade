{
  "name": "treadgrade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/prepare-public-data.mjs && astro dev",
    "prebuild": "node scripts/prepare-public-data.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "fetch": "node scripts/fetch-data.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test",
    "check:links": "node scripts/check-links.mjs",
    "check:html": "node scripts/check-html.mjs",
    "check:structured": "node scripts/check-structured.mjs",
    "check": "npm run validate:data && npm test && npm run build && npm run check:links && npm run check:html && npm run check:structured"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "html-validate": "^11.17.0"
  }
}
