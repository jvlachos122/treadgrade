---
const { items = [], narrow = false } = Astro.props;
---

{
  items.length ? (
    <nav class:list={["wrap", "crumbs", narrow && "narrow"]} aria-label="Breadcrumb">
      <ol>
        {items.map((item, index) => (
          <li>
            {index === items.length - 1 ? (
              <span aria-current="page">{item.label}</span>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  ) : null
}
