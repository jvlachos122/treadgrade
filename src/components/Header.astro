---
const path = Astro.url.pathname;
const links = [
  { href: "/ratings/", label: "Grades" },
  { href: "/brands/", label: "Brands" },
  { href: "/plants/", label: "Plants" },
  { href: "/who-makes-it/", label: "Who makes it" },
  { href: "/decoder/", label: "DOT decoder" },
];
function current(href) {
  return path === href || (href !== "/" && path.startsWith(href));
}
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="TreadGrade home">
      <img src="/brand/treadgrade-logo.svg" alt="TreadGrade" width="165" height="36" />
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
