---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/source-serif-4/latin-400.css";
import "@fontsource/source-serif-4/latin-700.css";
import plex400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import serif700 from "@fontsource/source-serif-4/files/source-serif-4-latin-700-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { refreshContent } from "../lib/redirects.js";
import { site, analyticsSnippet, searchConsoleToken } from "../lib/site.js";
import { breadcrumbList, schemaGraph } from "../lib/structured.js";

const {
  title,
  description,
  home = false,
  noindex = false,
  canonicalPath = "",
  redirectTo = "",
  breadcrumbs = [],
  narrow = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = home ? title : `${title} · ${site.name}`;
const canonical = new URL(canonicalPath || Astro.url.pathname, site.url).href;
const refreshUrl = redirectTo ? new URL(redirectTo, site.url).href : "";
const robotsNoindex = noindex || Boolean(redirectTo);
const token = searchConsoleToken();
const snippet = analyticsSnippet();
const graph = [];
if (breadcrumbs.length) graph.push(breadcrumbList(breadcrumbs));
for (const entry of jsonLd) graph.push(entry);
const structured = graph.length ? schemaGraph(graph) : "";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsNoindex ? <meta name="robots" content="noindex" /> : null}
    {refreshUrl ? <meta http-equiv="refresh" content={refreshContent(refreshUrl)} /> : null}
    <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif700} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f6f3ec" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TreadGrade — UTQG grades and DOT codes, from the public NHTSA files" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og-image.png`} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="impact-site-verification" value="0fcc0d4b-8097-40d0-a895-dbf397b4cf8a" />
    {token ? <meta name="google-site-verification" content={token} /> : null}
    {snippet ? <Fragment set:html={snippet} /> : null}
    {structured ? <script type="application/ld+json" set:html={structured} /> : null}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <Breadcrumbs items={breadcrumbs} narrow={narrow} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
