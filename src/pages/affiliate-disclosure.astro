---
import Base from "../layouts/Base.astro";
import { affiliatesConfigured } from "../lib/affiliates.js";
import { contactEmail, site } from "../lib/site.js";

const email = contactEmail();

const enabled = affiliatesConfigured();
const description = enabled
  ? `${site.legalName} may earn a commission when a configured retailer link on TreadGrade is used. Grade pages are not ordered by that commission.`
  : `Affiliate links are turned off. No retailer buttons are shown, and ${site.legalName} earns no commission from them.`;
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/affiliate-disclosure/", label: "Affiliate disclosure" },
];
---

<Base title="Affiliate disclosure" description={description} breadcrumbs={crumbs} narrow>
  <div class="wrap prose">
    <h1>Affiliate disclosure</h1>
    <p>TreadGrade is operated by {site.legalName}, {site.operatorPlace}.</p>
    {
      enabled ? (
        <p>
          Some tire-line pages show "check price" buttons. Those links go to a retailer and include an affiliate id from the site configuration.
          If you buy through one, {site.legalName} may earn a commission. The price, if any, is on the retailer's site. This site does not display a price of its own.
        </p>
      ) : (
        <p>
          Affiliate buttons are not configured. Tire-line pages do not show retailer links, and {site.legalName} does not earn a commission from them.
          The slots for Tire Rack, SimpleTire, and Amazon exist in the site configuration and stay empty until an id and an https link template are added.
        </p>
      )
    }
    <p>
      Grades, sort order, and which lines appear come from the NHTSA file. They are not arranged to favor a retailer. When a button is shown, the page says so next to the button and links here.
    </p>
    <p>See also the <a href="/privacy/">privacy</a> page.</p>
    {
      email ? (
        <p>
          Questions about this disclosure: <a href={`mailto:${email}`}>{email}</a>.
        </p>
      ) : null
    }
  </div>
</Base>
