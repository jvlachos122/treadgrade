---
import Base from "../layouts/Base.astro";
import Answer from "../components/Answer.astro";
import SourceLine from "../components/SourceLine.astro";
import { decoderAnswer, sourceEntries } from "../lib/answers.js";
import { catalog } from "../lib/catalog.js";
import { formatVerified } from "../lib/format.js";
import { buildDecoderExamples } from "../lib/hub-quality.js";
import { pageUrl, publisherOrg } from "../lib/structured.js";
import { clampText } from "../lib/text.js";
import { DECODER_QUERY_HINT } from "../lib/plant-query.js";

const answers = decoderAnswer(catalog);
const decoded = buildDecoderExamples(catalog.plants, new Date());
const description = clampText(answers.join(" "));
const title = "Tire DOT code decoder: plant, week and age";
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/decoder/", label: "DOT decoder" },
];
const jsonLd = [
  {
    "@type": "WebApplication",
    name: title,
    applicationCategory: "ReferenceApplication",
    operatingSystem: "Any",
    url: pageUrl("/decoder/"),
    description: answers.join(" "),
    dateModified: catalog.meta.verifiedAt,
    publisher: publisherOrg,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
];
const verified = formatVerified(catalog.meta.verifiedAt);
---

<Base title={title} description={description} breadcrumbs={crumbs} jsonLd={jsonLd}>
  <div class="wrap" data-decoder data-verified={catalog.meta.verifiedAt}>
    <h1>{title}</h1>
    <form class="decoder-form" action="/decoder/" method="get">
      <label>
        DOT code or TIN
        <input name="tin" type="text" autocapitalize="characters" autocomplete="off" spellcheck="false" inputmode="text" />
      </label>
      <button type="submit">Decode</button>
      <label class="decoder-check">
        <input name="triangle" type="checkbox" />
        <span>A triangle is molded after a three-digit date</span>
      </label>
    </form>
    <p class="small muted">{DECODER_QUERY_HINT}</p>
    <noscript>
      <p>
        Decoding a code you type runs in this browser. The worked examples below do not. Each row already names the plant, the week and year, and the age of that week on {decoded.asOfLabel} (UTC).
      </p>
    </noscript>
    <div data-output aria-live="polite"></div>
    <Answer sentences={answers} />
    <SourceLine sources={sourceEntries(catalog.meta, ["plants"])} />

    <h2 id="examples">Worked examples</h2>
    <div class="table-wrap">
      <table>
        <caption>
          Worked DOT readings from plant codes in NHTSA's list, verified {verified} (UTC). Six middle symbols, when shown, are a stand-in. Age is counted on {decoded.asOfLabel} (UTC). The box above uses the date in your browser.
        </caption>
        <thead>
          <tr>
            <th scope="col">Code typed</th>
            <th scope="col">Plant</th>
            <th scope="col">Week and year</th>
            <th scope="col">Age on {decoded.asOfLabel}</th>
          </tr>
        </thead>
        <tbody>
          {
            decoded.examples.map((example) => (
              <tr>
                <td>
                  <span class="code">{example.tin}</span>
                  <button type="button" class="button-ghost" data-example={example.tin}>Read in the tool</button>
                </td>
                <td>
                  <a href={example.plantUrl}><span class="code">{example.currentCode}</span></a>
                  {example.plantCode === example.currentCode ? null : (
                    <>
                      {" "}
                      from former code <span class="code">{example.plantCode}</span>
                    </>
                  )}
                  <br />
                  {example.plantName}
                  {example.place ? `, ${example.place}` : ""}. {example.layoutLabel}. {example.note}
                </td>
                <td>
                  Week {example.week} of {example.year}: {example.startLabel} through {example.endLabel}.
                </td>
                <td>{example.ageText}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="limits">What the code can't tell you</h2>
    <p>
      A plant match names the registrant stored on that code. It does not name the brand on the sidewall, and it does not say whether the tire is in a recall.
      <a href="/guides/rebadged-tires/">What a DOT code can prove about who made a tire</a> explains that limit.
      <a href="/recalls/">Tire recalls</a> lists campaigns from NHTSA's flat file. That page is not a TIN check.
    </p>

    <h2>Optional dates and a calendar file</h2>
    <div class="decoder-form">
    <label class="decoder-span">
      Purchase or install date, optional
      <input id="purchased" type="date" />
    </label>
    <p class="small decoder-span">
      Manufacturers stamp a production week, not a single day, so an age is a range.
      A DOT date is not an ISO week: ISO weeks start on Monday, and this site uses the Sunday–Saturday week in <a href="https://www.ecfr.gov/current/title-49/subtitle-B/chapter-V/part-574/section-574.5">49 CFR 574.5</a>.
      The optional date is a UTC calendar day, the same clock as the production week.
      <a href="/guides/tire-age/">How old is too old</a> quotes published positions. This page calculates dates. It does not decide whether a tire should stay in service.
    </p>
    <fieldset class="decoder-span decoder-remind">
      <legend>Calendar file from the manufacture week</legend>
      <p class="small">The file is built in this browser. Nothing is saved or sent. 5, 6, and 10 years are separate choices, counted from the production week.</p>
      <div class="button-row">
        <button type="button" class="button-ghost" data-remind="5">5 years</button>
        <button type="button" class="button-ghost" data-remind="6">6 years</button>
        <button type="button" class="button-ghost" data-remind="10">10 years</button>
      </div>
      <p class="small" data-remind-status>Decode a date code, then choose 5, 6, or 10 years if you want a calendar file.</p>
    </fieldset>
    </div>
    <div class="button-row">
      <button type="button" class="button-ghost" data-example="1U2">Example: plant code 1U2</button>
      <button type="button" class="button-ghost" data-example="U2">Example: former code U2</button>
      <button type="button" class="button-ghost" data-example="1U2HD">Example: partial code 1U2HD</button>
      <button type="button" class="button-ghost" data-example="0109">Example: date code 0109</button>
      <button type="button" class="button-ghost" data-example="329">Example: three-digit date 329</button>
      <button type="button" class="button-ghost" data-example="329" data-triangle="1">Example: 329 with a triangle</button>
    </div>
    <p class="small muted">
      0109 is the week in the regulation's example (the first full week of 2009), not a claim about a specific tire.
      329 shows a three-digit date.
      <a href="/guides/tire-date-code/">Tire date code: week and year digits</a>
      · <a href="/guides/dot-code/">DOT tire identification number</a>
      · <a href="/guides/dot-code/#three-digit-dates">Three-digit dates</a>
      · <a href="/guides/tire-age/">How old is too old</a>.
    </p>
    <p>
      The layout of the full number, the symbol rules, and the three-digit table stay on the guides linked above.
      <a href="/plants/by-maker/">Registered plant codes by maker and country</a>.
      Plant data last verified {verified} (UTC). <a href="/methodology/#data-quality">How this site reads the files</a>.
    </p>
  </div>
</Base>

<script>
  import { initDecoder } from "../scripts/decoder.js";
  const root = document.querySelector("[data-decoder]");
  if (root) initDecoder(root);
</script>
