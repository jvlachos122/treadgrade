---
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import SourceLine from "../../components/SourceLine.astro";
import { guidesIndexAnswer, sourceEntries } from "../../lib/answers.js";
import { catalog } from "../../lib/catalog.js";
import { recallSummary } from "../../lib/recall-catalog.js";
import { article, laterIso } from "../../lib/structured.js";
import { clampText } from "../../lib/text.js";
import InlineList from "../../components/InlineList.astro";
import { whoMakesPages } from "../../lib/who-makes-pages.js";

const answers = guidesIndexAnswer(catalog, recallSummary);
const description = clampText(answers.join(" "));
const jsonLd = [
  article({
    headline: "Tire grade, DOT, and date code guides",
    description: answers.join(" "),
    path: "/guides/",
    dateModified: laterIso(catalog.meta.verifiedAt, catalog.meta.recalls.retrievedAt),
  }),
];
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/guides/", label: "Guides" },
];
---

<Base title="Tire grade, DOT, and date code guides" description={description} breadcrumbs={crumbs} narrow jsonLd={jsonLd}>
  <div class="wrap prose">
    <h1>Guides</h1>
    <Answer sentences={answers} />
    <SourceLine sources={sourceEntries(catalog.meta, ["ratings", "plants", "recalls"])} />
    <p>Explainers for the data on this site. They stick to the regulations and to NHTSA's own descriptions.</p>
    <ul>
      <li>
        <a href="/guides/utqg-grades/">What UTQG treadwear, traction, and temperature grades mean</a>
        · <a href="/guides/traction-grades/">What traction grades AA, A, B, and C mean</a>
        · <a href="/guides/treadwear-numbers/">What treadwear numbers mean</a>
        · <a href="/ratings/">Open this list in the table</a>
        · <a href="/lists/highest-treadwear/">Highest treadwear grades NHTSA lists</a>
        · <a href="/lists/long-treadwear-high-traction/">Treadwear of 700 or above with traction A or AA and temperature A</a>
      </li>
      <li>
        <a href="/guides/tire-pressure-and-roadside-kit/">Tire pressure and a roadside kit</a>
      </li>
      <li>
        <a href="/guides/treadwear-varies-by-size/">Why treadwear can differ by size</a>
        · <a href="/compare/">Compare tire lines</a>
      </li>
      <li><a href="/guides/no-utqg-rating/">Why a tire may have no UTQG rating</a></li>
      <li><a href="/guides/dot-code/">How to read a DOT tire identification number</a></li>
      <li><a href="/guides/tire-date-code/">How to read a tire date code</a></li>
      <li><a href="/guides/tire-age/">How old is too old for tires</a></li>
    </ul>
    <h2>Recall filings</h2>
    <p>
      <a href="/who-makes-it/">Who makes it?</a> lists the company that filed each NHTSA tire recall since 2010.
      <a href="/recalls/">Tire recalls</a> lists the campaigns from that file and where to check a TIN.
      The filer may be the factory, an importer, or the brand owner. A brand with no tire recall in that file is not answered there.
      {
        whoMakesPages.length ? (
          <>
            {" "}
            <InlineList items={whoMakesPages.map((page) => ({ href: page.url, label: page.name }))} />
            {whoMakesPages.length === 1 ? " has" : " have"} a page of those filings.
          </>
        ) : null
      }
    </p>
    <p>
      The <a href="/methodology/">data sources</a> page describes the files. <a href="/methodology/known-errors/">Known errors</a> counts brand-string errors, values outside the usual grades, plant status, and which lines this pull does not contain.
      If a light-truck, winter, or temporary spare tire is missing from the ratings, start with <a href="/guides/no-utqg-rating/">why a tire may have no UTQG rating</a>.
      The <a href="/guides/utqg-grades/#not-in-the-list">grade guide</a> also says why a line may be absent.
    </p>
  </div>
</Base>
