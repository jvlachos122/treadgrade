---
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import GearLinks from "../../components/GearLinks.astro";
import Grade from "../../components/Grade.astro";
import SourceLine from "../../components/SourceLine.astro";
import { sourceEntries, utqgGuideAnswer } from "../../lib/answers.js";
import { catalog } from "../../lib/catalog.js";
import { formatNumber, formatVerified, percent } from "../../lib/format.js";
import { filterGradeRows, flattenGradeRows, ratingsTableHref, tireLineCount } from "../../lib/ratings-table.js";
import { article } from "../../lib/structured.js";
import { clampText } from "../../lib/text.js";
import {
  ACROSS_BRANDS_ID,
  CROSS_CHECK,
  ECFR_UTQG_URL,
  METHODOLOGY_PATH,
  RATINGS_PATH,
  SIZE_VARIANCE_PATH,
  TIRE_REVIEW_URL,
  acrossBrandsAnswer,
  acrossBrandsCaption,
  acrossBrandsIntro,
  acrossBrandsReport,
  ecfrRetrievedLabel,
  tireReviewPublishedLabel,
} from "../../lib/utqg-across-brands.js";
import {
  ECFR_TEMPERATURE_URL,
  FIGURE_2_TEMPERATURE,
  FIGURE_2_TEMPERATURE_WARNING,
  GRADE_C_STANDARD_QUOTE,
  GRADES_AB_ABOVE_MINIMUM_QUOTE,
  INDOOR_WHEEL_QUOTE,
  KNOWN_ERRORS_INVALID_HREF,
  SPEED_STAGE_QUOTE,
  TEMPERATURE_GRADES_ID,
  TEMPERATURE_INTRO_QUOTE,
  TEMPERATURE_LETTERS,
  TEMPERATURE_RULES,
  TEST_WHEEL_QUOTE,
  TRACTION_GRADES_PATH,
  TREADWEAR_NUMBERS_PATH,
  TREADWEAR_VS_TRACTION_PATH,
  cLineCaption,
  distributionCaption,
  ecfrRetrievedLabel as temperatureRetrievedLabel,
  invalidCaption,
  temperatureCountsParagraph,
  temperatureGradesAnswer,
  temperatureGradesReport,
  temperatureQualityNote,
  temperatureShare,
  thresholdCaption,
} from "../../lib/temperature-grades.js";

const { traction, wearBuckets, rows } = catalog.stats;
const answers = utqgGuideAnswer(catalog);
const description = clampText(answers.join(" "));
const jsonLd = [
  article({
    headline: "What UTQG tire grades mean",
    description: answers.join(" "),
    path: "/guides/utqg-grades/",
    dateModified: catalog.meta.verifiedAt,
  }),
];
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/guides/", label: "Guides" },
  { href: "/guides/utqg-grades/", label: "UTQG grades" },
];
const verified = formatVerified(catalog.meta.verifiedAt);
const across = acrossBrandsReport(catalog);
const acrossAnswers = acrossBrandsAnswer();
const acrossIntro = acrossBrandsIntro(across);
const acrossCaption = acrossBrandsCaption(catalog.meta.verifiedAt);
const acrossRetrieved = ecfrRetrievedLabel();
const tireReviewDate = tireReviewPublishedLabel();
const temperatureReport = temperatureGradesReport(catalog);
const temperatureAnswers = temperatureGradesAnswer();
const temperatureCounts = temperatureCountsParagraph(temperatureReport);
const temperatureQuality = temperatureQualityNote(temperatureReport);
const temperatureRetrieved = temperatureRetrievedLabel();
const temperatureRulesCaption = thresholdCaption();
const temperatureDistributionCaption = distributionCaption(temperatureReport);
const temperatureCCaption = cLineCaption(temperatureReport);
const temperatureInvalidCaption = invalidCaption(temperatureReport);
const highWear = filterGradeRows(flattenGradeRows(catalog), {
  wearMin: "700",
  traction: ["AA", "A"],
  temp: ["A"],
});
const wearRows = [
  ["Below 200", wearBuckets.under200],
  ["200–300", wearBuckets.from200to300],
  ["301–400", wearBuckets.from301to400],
  ["401–500", wearBuckets.from401to500],
  ["501–600", wearBuckets.from501to600],
  ["Above 600", wearBuckets.over600],
  ["Not reported", wearBuckets.missing],
];
---

<Base title="What UTQG tire grades mean" description={description} breadcrumbs={crumbs} narrow jsonLd={jsonLd}>
  <div class="wrap prose">
    <h1>What UTQG tire grades mean</h1>
    <Answer sentences={answers} />
    <SourceLine sources={sourceEntries(catalog.meta, ["ratings"])} />
    <p>
      UTQG is the Uniform Tire Quality Grading system. 49 CFR 575.104 requires tire makers and brand owners to grade new passenger-car tires for treadwear, traction, and temperature resistance so buyers can compare them.
      The rule's stated purpose is to help a consumer choose among passenger-car tires.
    </p>
    <p>
      It applies to new pneumatic tires for passenger cars. It does not apply to deep-tread, winter-type snow tires, space-saver or temporary-use spare tires, tires with nominal rim diameters of 12 inches or less, or limited-production tires as the regulation defines them.
      Source: <a href="https://www.law.cornell.edu/cfr/text/49/575.104">49 CFR 575.104</a>
      (<a href="https://www.ecfr.gov/current/title-49/subtitle-B/chapter-V/part-575/section-575.104">eCFR</a>).
      NHTSA's 2017 consumer guide uses the same scope: passenger-car tires, with those exceptions
      (<a href="https://www.nhtsa.gov/sites/nhtsa.gov/files/documents/812459_2017uniformtirequalitygradingconsumerguide_0.pdf">DOT HS 812 459</a>).
    </p>
    <h2 id="not-in-the-list">If you are looking for a light-truck, winter, or spare tire</h2>
    <p>
      Light-truck tires are outside this rule because it applies to passenger-car tires, not because the ratings file has an "LT" switch. The file has no category field, so this site cannot label a row as light truck, winter, or spare.
    </p>
    <p>
      Deep-tread, winter-type snow tires and space-saver or temporary-use spare tires are named exceptions in 49 CFR 575.104(c)(1).
      NHTSA has said the winter exception is a deep tread and tread design that makes year-round use on a passenger car inadvisable. All-season tires are not that exception
      (<a href="https://www.nhtsa.gov/interpretations/86-249">NHTSA interpretation, 1986</a>, citing 44 FR 30140, May 24, 1979).
    </p>
    <p>
      A line that is missing may be outside the rule, or it may be a passenger-car tire NHTSA's list simply does not contain. Absence is not a grade, and it does not say the tire is unsold. A number that is high inside the list is a high number in NHTSA's list, not "the best tire."
      The exemption list, the LT size marks, and the BFGoodrich lines in this file are on <a href="/guides/no-utqg-rating/">why a tire may have no UTQG rating</a>.
    </p>
    <h2>The grades, as the regulation tells buyers to read them</h2>
    <p>
      Figure 2 of the regulation is the explanation that has to be available to tire buyers. The three passages below are that text.
      Where the quotation says a grade is the highest, that is the regulation's ordering of the grade letters. It is not a claim that any row on this site is the best tire in NHTSA's list or on the market.
    </p>
    <h3>Treadwear</h3>
    <blockquote class="quote">
      <p>
        The treadwear grade is a comparative rating based on the wear rate of the tire when tested under controlled conditions on a specified government test course. For example, a tire graded 150 would wear one and one-half (1 1/2) times as well on the government course as a tire graded 100. The relative performance of tires depends upon the actual conditions of their use, however, and may depart significantly from the norm due to variations in driving habits, service practices and differences in road characteristics and climate.
      </p>
    </blockquote>
    <p>
      The grade is a whole number in multiples of 20, such as 80, 120, or 160, expressed as a percentage of the NHTSA nominal treadwear value on that course. A higher number means a slower wear rate on the course. It is not a promised mileage.
      <a href="/guides/treadwear-numbers/">What treadwear numbers mean</a> counts where each grade sits in this file.
    </p>
    <h3>Traction</h3>
    <blockquote class="quote">
      <p>
        The traction grades, from highest to lowest, are AA, A, B, and C. Those grades represent the tire's ability to stop on wet pavement as measured under controlled conditions on specified government test surfaces of asphalt and concrete. A tire marked C may have poor traction performance. Warning: The traction grade assigned to this tire is based on straight-ahead braking traction tests, and does not include acceleration, cornering, hydroplaning, or peak traction characteristics.
      </p>
    </blockquote>
    <p>
      <a href="/guides/traction-grades/">Traction grades AA, A, B, and C</a>
      covers the locked-wheel test, the coefficient for each letter, and the counts in this file.
    </p>
    <h3>Temperature</h3>
    <blockquote class="quote">
      <p>{FIGURE_2_TEMPERATURE}</p>
      <p id="underinflation">{FIGURE_2_TEMPERATURE_WARNING}</p>
    </blockquote>
    <p>
      That Figure 2 wording is the eCFR text retrieved {temperatureRetrieved}.
      <a href={`#${TEMPERATURE_GRADES_ID}`}>Temperature grades A, B, and C</a>
      quotes the indoor laboratory test wheel and the 500 rpm and 575 rpm stages.
      NHTSA's monthly pressure check, the placard pressure, and the spare are on
      <a href="/guides/tire-pressure-and-roadside-kit/">tire pressure and a roadside kit</a>.
    </p>
    <GearLinks />
    <h2>How the rows in this site's file are distributed</h2>
    <p>
      These shares are of the {formatNumber(rows)} grade rows in NHTSA's list as this site last verified it. They are not shares of tires currently for sale, and they are not the "of current tires" figures NHTSA has published elsewhere.
      Treadwear and traction are in the tables below. Temperature grade rows and the tire lines that carry each letter are in
      <a href={`#${TEMPERATURE_GRADES_ID}`}>Temperature grades A, B, and C</a>.
    </p>
    <div class="table-wrap">
      <table>
        <caption>Treadwear rows</caption>
        <thead>
          <tr>
            <th scope="col">Treadwear</th>
            <th scope="col">Rows</th>
            <th scope="col">Share</th>
          </tr>
        </thead>
        <tbody>
          {
            wearRows.map(([label, count]) => (
              <tr>
                <td>{label}</td>
                <td class="num">{formatNumber(count)}</td>
                <td class="num">{percent(count, rows)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="table-wrap">
      <table>
        <caption>Traction rows</caption>
        <thead>
          <tr>
            <th scope="col">Grade</th>
            <th scope="col">Rows</th>
            <th scope="col">Share</th>
          </tr>
        </thead>
        <tbody>
          {
            ["AA", "A", "B", "C", "other"].map((grade) => (
              <tr>
                <td>{grade === "other" ? "Outside AA–C" : grade}</td>
                <td class="num">{formatNumber(traction[grade])}</td>
                <td class="num">{percent(traction[grade], rows)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>
      In the NHTSA UTQG file verified {verified} (UTC), treadwear of at least 700 with traction AA or A and temperature A is {formatNumber(highWear.length)} grade rows on {formatNumber(tireLineCount(highWear))} tire lines.
    </p>
    <p>
      <a href={ratingsTableHref({ traction: ["AA"] })}>Open this list in the table: traction AA</a>
      · <a href={ratingsTableHref({ temp: ["A"] })}>Open this list in the table: temperature A</a>
      · <a href={ratingsTableHref({ wearMin: "600" })}>Open this list in the table: treadwear of at least 600</a>
      · <a href={ratingsTableHref({ wearMin: "700", traction: ["AA", "A"], temp: ["A"] })}>Open this list in the table: treadwear of at least 700, traction AA or A, temperature A</a>
      · <a href="/lists/highest-treadwear/">Treadwear of 800 or above</a>
      · <a href="/lists/long-treadwear-high-traction/">Tire lines at treadwear of at least 700, traction AA or A, temperature A</a>
    </p>
    <p>
      The same line can list more than one treadwear or traction grade across the size rows NHTSA published.
      <a href="/guides/treadwear-varies-by-size/">Why treadwear can differ by size</a>.
    </p>
    <h2 id={TEMPERATURE_GRADES_ID}>Temperature grades A, B and C explained</h2>
    {temperatureAnswers.map((sentence) => <p>{sentence}</p>)}
    <p>
      Paragraph (d)(2)(iii) and paragraph (g) of
      <a href={ECFR_TEMPERATURE_URL}>49 CFR 575.104</a>
      (eCFR, retrieved {temperatureRetrieved}).
      Figure 2 is the explanation shown to tire buyers. Where it says A is the highest, that is the regulation's ordering of the letters.
    </p>
    <blockquote class="quote">
      <p>{INDOOR_WHEEL_QUOTE}</p>
      <p>{GRADE_C_STANDARD_QUOTE}</p>
      <p>{GRADES_AB_ABOVE_MINIMUM_QUOTE}</p>
    </blockquote>
    <blockquote class="quote">
      <p>{TEMPERATURE_INTRO_QUOTE}</p>
    </blockquote>
    <blockquote class="quote">
      <p>{TEST_WHEEL_QUOTE}</p>
      <p>{SPEED_STAGE_QUOTE}</p>
    </blockquote>
    <p>
      Paragraph (g)(9) is the speed sequence. The grade rules name the 500 rpm test stage and the 575 rpm test stage in that sequence. The paragraph letters in (d)(2)(iii) are not the grade letters.
    </p>
    <div class="table-wrap">
      <table>
        <caption>{temperatureRulesCaption}</caption>
        <thead>
          <tr>
            <th scope="col">Grade</th>
            <th scope="col">Paragraph</th>
            <th scope="col">Rule printed in the section</th>
          </tr>
        </thead>
        <tbody>
          {
            TEMPERATURE_RULES.map((rule) => (
              <tr>
                <td><Grade value={rule.id} kind="temp" /></td>
                <td>{rule.paragraph}</td>
                <td>{rule.quote}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>{temperatureCounts}</p>
    <div class="table-wrap">
      <table>
        <caption>{temperatureDistributionCaption}</caption>
        <thead>
          <tr>
            <th scope="col">Grade</th>
            <th scope="col">Grade rows</th>
            <th scope="col">Share of grade rows</th>
            <th scope="col">Tire lines</th>
          </tr>
        </thead>
        <tbody>
          {
            temperatureReport.grades.map((grade) => (
              <tr>
                <td>{grade.id === "outside" ? grade.label : <Grade value={grade.id} kind="temp" />}</td>
                <td class="num">{formatNumber(grade.rows)}</td>
                <td class="num">{temperatureShare(temperatureReport, grade)}</td>
                <td class="num">{formatNumber(grade.lines)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>
      {
        TEMPERATURE_LETTERS.map((grade, index) => (
          <>
            {index ? " · " : ""}
            <a href={ratingsTableHref({ temp: [grade] })}>Open temperature {grade} in the table</a>
          </>
        ))
      }
    </p>
    {
      temperatureReport.cLines.length ? (
        <div class="table-wrap">
          <table>
            <caption>{temperatureCCaption}</caption>
            <thead>
              <tr>
                <th scope="col">Brand</th>
                <th scope="col">Tire line</th>
                <th scope="col">Grade rows with C</th>
                <th scope="col">Other temperature values</th>
              </tr>
            </thead>
            <tbody>
              {
                temperatureReport.cLines.map((line) => (
                  <tr>
                    <td>{line.brand}</td>
                    <td>
                      <a href={line.url}>{line.line}</a>
                    </td>
                    <td class="num">{formatNumber(line.cRows)}</td>
                    <td>
                      {
                        line.others.length || line.invalid.length ? (
                          <>
                            {
                              line.others.map((value, index) => (
                                <>
                                  {index ? ", " : ""}
                                  <Grade value={value} kind="temp" />
                                </>
                              ))
                            }
                            {line.others.length && line.invalid.length ? ", " : ""}
                            {
                              line.invalid.map((value, index) => (
                                <>
                                  {index ? ", " : ""}
                                  {`"${value}"`}
                                </>
                              ))
                            }
                          </>
                        ) : (
                          "C only"
                        )
                      }
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      ) : (
        <p>This pull has no grade row with temperature C.</p>
      )
    }
    <h3 id="temperature-data-quality">Data quality</h3>
    <p>
      {temperatureQuality}
      {" "}
      <a href={KNOWN_ERRORS_INVALID_HREF}>Values outside the usual grades</a>.
    </p>
    {
      temperatureReport.invalidRows.length ? (
        <div class="table-wrap">
          <table>
            <caption>{temperatureInvalidCaption}</caption>
            <thead>
              <tr>
                <th scope="col">Published temperature</th>
                <th scope="col">Brand</th>
                <th scope="col">Tire line</th>
                <th scope="col">Grade rows</th>
              </tr>
            </thead>
            <tbody>
              {
                temperatureReport.invalidRows.map((row) => (
                  <tr>
                    <td>{`"${row.value}"`}</td>
                    <td>{row.brand}</td>
                    <td>
                      <a href={row.url}>{row.line}</a>
                    </td>
                    <td class="num">{formatNumber(row.rows)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      ) : null
    }
    <p>
      <a href={TRACTION_GRADES_PATH}>Traction grades AA, A, B, and C</a>.
      <a href={TREADWEAR_NUMBERS_PATH}>What treadwear numbers mean</a>.
      <a href={TREADWEAR_VS_TRACTION_PATH}>Treadwear next to traction and temperature</a>.
      <a href={RATINGS_PATH}>Ratings table</a>.
      <a href={METHODOLOGY_PATH}>How the file is read</a>.
    </p>
    <h2 id={ACROSS_BRANDS_ID}>Can you compare UTQG grades across brands?</h2>
    {acrossAnswers.map((sentence) => <p>{sentence}</p>)}
    <p>
      Sources:
      <a href={ECFR_UTQG_URL}>49 CFR 575.104</a> (eCFR, retrieved {acrossRetrieved}),
      and <a href={TIRE_REVIEW_URL}>Tire Review, {tireReviewDate}</a>.
    </p>
    <p>{acrossIntro}</p>
    <div class="table-wrap">
      <table>
        <caption>{acrossCaption}</caption>
        <thead>
          <tr>
            <th scope="col">Brand</th>
            <th scope="col">Graded lines</th>
            <th scope="col">Grade rows</th>
            <th scope="col">Median treadwear</th>
            <th scope="col">10th–90th treadwear</th>
            <th scope="col">Traction AA or A</th>
          </tr>
        </thead>
        <tbody>
          {
            across.brands.map((brand) => (
              <tr>
                <td>
                  <a href={brand.url}>{brand.name}</a>
                </td>
                <td class="num">{formatNumber(brand.lineCount)}</td>
                <td class="num">{formatNumber(brand.rowCount)}</td>
                <td class="num">{brand.medianText}</td>
                <td class="num">{brand.spanText}</td>
                <td class="num">{brand.shareText}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <h3>What to cross-check</h3>
    <ul>
      {
        CROSS_CHECK.map((item) => (
          <li>
            {item.text}
            {item.id === "size" ? (
              <>
                {" "}
                <a href={SIZE_VARIANCE_PATH}>Why treadwear can differ by size</a>
                {" · "}
                <a href={RATINGS_PATH}>Ratings table</a>.
              </>
            ) : null}
          </li>
        ))
      }
    </ul>
    <p>
      <a href={METHODOLOGY_PATH}>How the file is read</a>.
    </p>
    <h2>What a grade page on this site is not</h2>
    <p>
      A tire-line page repeats the size series and grades NHTSA published. It does not say the tire is still sold, does not estimate street mileage, and does not rank a tire as the best or highest in the list. NHTSA's own tire page is a useful companion:
      <a href="https://www.nhtsa.gov/vehicle-safety/tires">TireWise</a>.
    </p>
  </div>
</Base>
