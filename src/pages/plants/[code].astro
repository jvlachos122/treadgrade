---
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import PlantNote from "../../components/PlantNote.astro";
import SourceLine from "../../components/SourceLine.astro";
import { plantAnswer, sourceEntries } from "../../lib/answers.js";
import { catalog } from "../../lib/catalog.js";
import { dataset } from "../../lib/structured.js";
import { clampText } from "../../lib/text.js";
import { whoMakesByPlantCode } from "../../lib/who-makes-pages.js";

export function getStaticPaths() {
  return catalog.plants.map((plant) => ({ params: { code: plant.slug } }));
}

const plant = catalog.getPlant(Astro.params.code);
const answers = plantAnswer(plant);
const description = clampText(answers.join(" "));
const jsonLd = [
  dataset({
    name: `NHTSA plant record ${plant.code}`,
    description: answers.join(" "),
    path: plant.url,
    dateModified: catalog.meta.verifiedAt,
    isBasedOn: catalog.meta.plants.source,
    keywords: ["DOT", "plant code", "NHTSA"],
  }),
];
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/plants/", label: "Plant codes" },
  { href: plant.url, label: plant.code },
];
const makerLinks = whoMakesByPlantCode.get(plant.code) || [];
const shared = plant.oldCodeSharedWith
  .map((code) => catalog.getPlant(code.toLowerCase()))
  .filter(Boolean);
---

<Base title={`DOT plant code ${plant.code}`} description={description} breadcrumbs={crumbs} jsonLd={jsonLd}>
  <div class="wrap">
    <h1>DOT plant code <span class="code">{plant.code}</span></h1>
    <Answer sentences={answers} />
    <SourceLine sources={sourceEntries(catalog.meta, ["plants"])} />
    <PlantNote />
    <dl class="facts">
      <div>
        <dt>Current plant code</dt>
        <dd class="num code">{plant.code}</dd>
      </div>
      <div>
        <dt>Former code</dt>
        <dd class="num code">{plant.oldCode || "None in this record"}</dd>
      </div>
      <div>
        <dt>Plant name</dt>
        <dd>{plant.name}</dd>
      </div>
      <div>
        <dt>Address</dt>
        <dd>{plant.address || "Not included in the NHTSA record"}</dd>
      </div>
      <div>
        <dt>City and region</dt>
        <dd>{[plant.city, plant.state, plant.postal].filter(Boolean).join(", ") || "Not included in the NHTSA record"}</dd>
      </div>
      <div>
        <dt>Country</dt>
        <dd>{plant.country || "Not included in the NHTSA record"}</dd>
      </div>
      <div>
        <dt>Status field</dt>
        <dd>
          {plant.status || "Not included in the NHTSA record"}. This is the value stored in vPIC, not a finding that the company or plant is operating today.
        </dd>
      </div>
    </dl>
    {
      plant.oldCode ? (
        <p>
          Tires molded with the older two-symbol code {plant.oldCode} point at this same plant record
          {shared.length ? ", and that former code is also listed on another plant record" : ""}.
        </p>
      ) : null
    }
    {
      shared.length ? (
        <ul>
          {shared.map((other) => (
            <li>
              Former code {plant.oldCode} is also on <a href={other.url}>{other.code}</a>, {other.name}.
            </li>
          ))}
        </ul>
      ) : null
    }
    {
      plant.sameName.length ? (
        <>
          <h2>Other records with this plant name</h2>
          <ul>
            {plant.sameName.map((other) => (
              <li>
                <a href={other.url}>{other.code}</a>
                {other.city || other.country ? ` — ${[other.city, other.country].filter(Boolean).join(", ")}` : ""}
              </li>
            ))}
          </ul>
        </>
      ) : null
    }
    {
      makerLinks.length ? (
        <>
          <h2>Recall filings that match this registrant</h2>
          <p>
            This plant's name matches a company on a tire-recall filing. The plant record does not say this plant made that brand.
          </p>
          <ul>
            {
              makerLinks.map((link) => (
                <li>
                  <a href={link.url}>Who makes {link.name} tires?</a>
                  {" "}
                  ({link.role === "filer" ? "filing company" : "manufacturer field"} {link.matchedCompany}).
                </li>
              ))
            }
          </ul>
        </>
      ) : null
    }
    <p>
      <a href={`/decoder/?tin=${plant.code}`}>Decode a code that starts with {plant.code}</a>
      · <a href="/guides/tire-date-code/">How to read a tire date code</a>
      · <a href="/guides/dot-code/">How to read a DOT code</a>
      · <a href="/plants/">All plant codes</a>
    </p>
  </div>
</Base>
