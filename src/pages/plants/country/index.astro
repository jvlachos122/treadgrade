---
import Base from "../../../layouts/Base.astro";
import Answer from "../../../components/Answer.astro";
import PlantNote from "../../../components/PlantNote.astro";
import SourceLine from "../../../components/SourceLine.astro";
import { countryIndexAnswer, sourceEntries } from "../../../lib/answers.js";
import { catalog } from "../../../lib/catalog.js";
import { formatNumber } from "../../../lib/format.js";
import { countryHubs, countryNormalization, hubDataset } from "../../../lib/plant-hubs.js";
import { clampText } from "../../../lib/text.js";

const answers = countryIndexAnswer({
  rawCount: countryNormalization.rawCount,
  normalizedCount: countryNormalization.normalizedCount,
  plantCount: catalog.stats.plants,
});
const description = clampText(answers.join(" "));
const jsonLd = [
  hubDataset({
    name: "NHTSA plant records grouped by country",
    description: answers.join(" "),
    path: "/plants/country/",
    keywords: ["DOT", "plant code", "NHTSA"],
  }),
];
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/plants/", label: "Plant codes" },
  { href: "/plants/country/", label: "Countries" },
];
---

<Base title="Plant codes by country" description={description} breadcrumbs={crumbs} jsonLd={jsonLd}>
  <div class="wrap">
    <h1>Plant codes by country</h1>
    <Answer sentences={answers} />
    <SourceLine sources={sourceEntries(catalog.meta, ["plants"])} />
    <PlantNote />
    <div class="table-wrap">
      <table>
        <caption>
          Country strings in NHTSA's equipment plant list after case, spelling, and alias normalization.
          Stored strings are the softened forms of the values in the file.
        </caption>
        <thead>
          <tr>
            <th scope="col">Country</th>
            <th scope="col">Records</th>
            <th scope="col">Stored as</th>
          </tr>
        </thead>
        <tbody>
          {
            countryHubs.map((country) => (
              <tr>
                <td><a href={country.url}>{country.label}</a></td>
                <td class="num">{formatNumber(country.count)}</td>
                <td>{country.rawLabels.join("; ")}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>
      <a href="/plants/">All plant codes</a>
      · <a href="/plants/manufacturer/">Manufacturer name groups</a>
      · <a href="/decoder/">DOT decoder</a>
    </p>
  </div>
</Base>
