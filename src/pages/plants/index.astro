---
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import PlantNote from "../../components/PlantNote.astro";
import SourceLine from "../../components/SourceLine.astro";
import { plantsIndexAnswer, sourceEntries } from "../../lib/answers.js";
import { catalog } from "../../lib/catalog.js";
import { formatNumber } from "../../lib/format.js";
import { MAKER_COUNTRY_DEFS, MAKER_COUNTRY_MIN } from "../../lib/plant-groups.js";
import { plantCaptions, plantHubFaqs, plantHubModel, plantHubProse, hubFaqLd } from "../../lib/hub-quality.js";
import { dataset } from "../../lib/structured.js";
import { PLANTS_QUERY_HINT } from "../../lib/plant-query.js";
import { clampText } from "../../lib/text.js";

const answers = plantsIndexAnswer(catalog);
const description = clampText(answers.join(" "));
const model = plantHubModel(catalog.plants, catalog.countries, MAKER_COUNTRY_DEFS, MAKER_COUNTRY_MIN);
const captions = plantCaptions(catalog.meta.verifiedAt);
const prose = plantHubProse(model);
const faqs = plantHubFaqs(model);
const jsonLd = [
  dataset({
    name: "NHTSA tire plant codes",
    description: answers.join(" "),
    path: "/plants/",
    dateModified: catalog.meta.verifiedAt,
    isBasedOn: catalog.meta.plants.source,
    keywords: ["DOT", "plant code", "NHTSA"],
  }),
  hubFaqLd(faqs),
];
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/plants/", label: "Plant codes" },
];
const statuses = ["Active", "Closed", "Not stated"];
const countryLabel = new Map(model.countries.map((country) => [country.key, country.label]));
let previousCountry = "";
const groupedPlants = [...catalog.plants]
  .sort((a, b) => {
    const left = countryLabel.get(a.countryKey) || a.country || "";
    const right = countryLabel.get(b.countryKey) || b.country || "";
    return left.localeCompare(right, "en") || a.code.localeCompare(b.code);
  })
  .map((plant) => {
    const label = countryLabel.get(plant.countryKey) || plant.country || "Not stored";
    const anchor = label !== previousCountry ? `country-${plant.countryKey}` : "";
    previousCountry = label;
    return { plant, label, anchor };
  });
const countryAnchors = groupedPlants.filter((row) => row.anchor);
---

<Base title="DOT tire plant codes" description={description} breadcrumbs={crumbs} jsonLd={jsonLd}>
  <div class="wrap" data-plants data-verified={catalog.meta.verifiedAt}>
    <h1>DOT tire plant codes</h1>
    <Answer sentences={answers} />
    <SourceLine sources={sourceEntries(catalog.meta, ["plants"])} />
    <div class="filter-row">
      <label>
        Code, brand, name, or city
        <input type="search" data-filter-q autocomplete="off" />
      </label>
      <label>
        Maker
        <select data-filter-maker>
          <option value="">Any</option>
          {model.makers.map((maker) => <option value={maker.id}>{maker.label} ({formatNumber(maker.count)})</option>)}
          {model.otherCount ? <option value="other">Other registered names ({formatNumber(model.otherCount)})</option> : null}
        </select>
      </label>
      <label>
        Country
        <select data-filter-country>
          <option value="">Any</option>
          {catalog.countries.map((country) => <option value={country.key}>{country.label} ({formatNumber(country.count)})</option>)}
        </select>
      </label>
      <label>
        Status field
        <select data-filter-status>
          <option value="">Any</option>
          {statuses.map((status) => <option value={status}>{status}</option>)}
        </select>
      </label>
    </div>
    <p class="status" data-filter-status-text aria-live="polite">{formatNumber(catalog.stats.plants)} plants.</p>
    <p class="small muted">{PLANTS_QUERY_HINT}</p>
    <div data-lookup></div>
    <noscript>
      <p>Maker, country, and status filters run in the browser. Without JavaScript every plant row stays visible, grouped by country below.</p>
    </noscript>

    <h2 id="makers">Largest name groups</h2>
    <p>
      {formatNumber(model.makers.length)} registrant-name groups meet the published minimum.
      {model.makers[0] ? `${model.makers[0].label} is the largest, with ${formatNumber(model.makers[0].count)} registered codes.` : ""}
      The other {formatNumber(model.otherCount)} records stay in the plant table.
    </p>
    <div class="table-wrap">
      <table>
        <caption>{captions.makers}</caption>
        <thead>
          <tr>
            <th scope="col">Maker</th>
            <th scope="col">Registered codes</th>
            <th scope="col">Countries</th>
            <th scope="col">Where to open the codes</th>
          </tr>
        </thead>
        <tbody>
          {
            model.makers.map((maker) => (
              <tr>
                <td><a href={maker.crossUrl}>{maker.label}</a></td>
                <td class="num">{formatNumber(maker.count)}</td>
                <td class="num">{formatNumber(maker.countries)}</td>
                <td>
                  {maker.hubUrl ? <a href={maker.hubUrl}>Code list</a> : null}
                  {maker.hubUrl ? " · " : null}
                  <a href={maker.crossUrl}>By country</a>
                </td>
              </tr>
            ))
          }
          <tr>
            <td>Other registered names</td>
            <td class="num">{formatNumber(model.otherCount)}</td>
            <td class="num">—</td>
            <td>In the plant table below</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 id="codes">Plant codes by country</h2>
    <PlantNote />
    <nav class="letter-nav" aria-label="Countries">
      {countryAnchors.map((row) => <a href={`#${row.anchor}`}>{row.label}</a>)}
    </nav>
    <div class="table-wrap">
      <table data-plant-table>
        <caption>{captions.plants}</caption>
        <thead>
          <tr>
            <th scope="col">Code</th>
            <th scope="col">Former code</th>
            <th scope="col">Plant</th>
            <th scope="col">Location</th>
            <th scope="col">Status field</th>
          </tr>
        </thead>
        <tbody>
          {
            groupedPlants.map(({ plant, anchor }) => (
              <tr
                id={anchor || undefined}
                data-search={`${plant.code} ${plant.oldCode} ${plant.name} ${plant.city} ${plant.country} ${plant.countryRaw}`.toLowerCase()}
                data-code={plant.code}
                data-old={plant.oldCode}
                data-name={plant.name}
                data-city={plant.city}
                data-country-name={plant.country}
                data-url={plant.url}
                data-plant-status={plant.status || ""}
                data-country={plant.countryKey}
                data-maker={model.makerByCode.get(plant.code)}
                data-status={plant.status || "Not stated"}
              >
                <td class="num code">
                  <a href={plant.url}>{plant.code}</a>
                </td>
                <td class="num code">{plant.oldCode || "—"}</td>
                <td>{plant.name}</td>
                <td>{[plant.city, plant.state, plant.country].filter(Boolean).join(", ")}</td>
                <td>{plant.status || "Not stated"}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="countries">Counts by country</h2>
    <div class="table-wrap">
      <table>
        <caption>{captions.countries}</caption>
        <thead>
          <tr>
            <th scope="col">Country</th>
            <th scope="col">Registered codes</th>
          </tr>
        </thead>
        <tbody>
          {
            model.countries.map((country) => (
              <tr>
                <td>{country.url ? <a href={country.url}>{country.label}</a> : country.label}</td>
                <td class="num">{formatNumber(country.count)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="small">
      Former codes are not separate pages. They are listed on the plant record that carries that code, and in this table.
      <a href="/guides/dot-code/">How a plant code fits into a DOT number</a>
      · <a href="/guides/rebadged-tires/">What a plant code can prove about who made a tire</a>
      · <a href="/guides/tire-date-code/">How to read the date code</a>
      <a href="/plants/by-maker/">Registered plant codes by maker and country</a>
      · <a href="/plants/manufacturer/">Manufacturer name groups</a>
      · <a href="/plants/country/">Plant codes by country</a>.
    </p>
    <div class="prose">
      {prose.map((paragraph) => <p>{paragraph}</p>)}
      <h2>Questions</h2>
      {
        faqs.map((item) => (
          <>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </>
        ))
      }
    </div>
  </div>
</Base>

<script>
  import { initTableFilter } from "../../scripts/table-filter.js";
  const root = document.querySelector("[data-plants]");
  if (root) initTableFilter(root);
</script>
