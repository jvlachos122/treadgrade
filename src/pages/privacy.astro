---
import Base from "../layouts/Base.astro";
import { gearConfigured, retailersConfigured } from "../lib/affiliates.js";
import { analyticsSnippet, contactEmail, site } from "../lib/site.js";

const email = contactEmail();
const retailers = retailersConfigured();
const gear = gearConfigured();

const description =
  "What TreadGrade stores: a static site with no accounts, no cookies of its own, and no analytics unless Three Pines Company LLC adds a snippet.";
const crumbs = [
  { href: "/", label: "Home" },
  { href: "/privacy/", label: "Privacy" },
];
---

<Base title="Privacy" description={description} breadcrumbs={crumbs} narrow>
  <div class="wrap prose">
    <h1>Privacy</h1>
    <p>TreadGrade is operated by {site.legalName}, {site.operatorPlace}.</p>
    <p>
      TreadGrade is a static website. There are no accounts, no search logs kept by this site, and no forms that send a message to a server here. The ratings search, the plant directory filter, and the DOT decoder run in your browser.
    </p>
    <p>
      The site is published with GitHub Pages. GitHub receives ordinary web-server data such as IP address and the page requested when your browser loads a page. Their policy is the
      <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub General Privacy Statement</a>.
    </p>
    {
      analyticsSnippet() ? (
        <p>{site.legalName} has added an analytics snippet in the site configuration. That snippet loads from this page's head. Review the vendor named in that configuration for what it collects.</p>
      ) : (
        <p>No analytics snippet is configured. This site does not load a third-party analytics script.</p>
      )
    }
    {
      retailers ? (
        <p>
          A configured "check price" button leaves this site for the retailer's site. That retailer has its own policy.
        </p>
      ) : (
        <p>
          Retailer buttons are off. They stay off unless an affiliate id and an https link template are configured.
        </p>
      )
    }
    {
      gear ? (
        <p>
          A configured roadside-gear link leaves this site for AstroAI through the Awin network. Awin and AstroAI have their own policies.
          The link is a plain address. This site does not load an Awin script, tracking pixel, or image.
        </p>
      ) : (
        <p>
          Roadside-gear links to AstroAI through Awin are off. No AstroAI address is configured.
          This site does not load an Awin script, tracking pixel, or image.
        </p>
      )
    }
    <p>
      See the <a href="/affiliate-disclosure/">affiliate disclosure</a>.
    </p>
    {
      email ? (
        <p>
          Questions about this page: <a href={`mailto:${email}`}>{email}</a>.
        </p>
      ) : null
    }
  </div>
</Base>
